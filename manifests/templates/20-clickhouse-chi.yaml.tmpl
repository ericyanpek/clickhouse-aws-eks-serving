apiVersion: "clickhouse.altinity.com/v1"
kind: "ClickHouseInstallation"
metadata:
  name: __CLUSTER__
  namespace: __NAMESPACE__
spec:
  defaults:
    templates:
      podTemplate: ch-pod
      dataVolumeClaimTemplate: ch-data
      serviceTemplate: ch-cluster-ip
  configuration:
    zookeeper:
      nodes:
        - host: keeper-__CLUSTER__-keeper.__NAMESPACE__.svc.cluster.local
          port: 2181
      # Per-cluster coordination root: clusters must never share ZooKeeper paths,
      # even if they were ever pointed at the same Keeper ensemble.
      root: /clickhouse/__CLUSTER__
    users:
      # SECURITY: password_sha256_hex must be a valid 64-char hex — an empty string is REJECTED
      # by ClickHouse (CANNOT_LOAD_CONFIG, exit 91). Generate before apply and substitute the
      # placeholder below (deploy.sh does this, like the S3 backup placeholders):
      #   printf '%s' 'your-strong-password' | sha256sum
      # NEVER commit a real hash to a public repo.
      admin/password_sha256_hex: "REPLACE_WITH_ADMIN_SHA256"
      # networks/ip: open to the VPC CIDR so in-cluster clients (e.g. benchmark pods) can connect.
      # Narrow this to specific subnets/pods for production.
      admin/networks/ip: "10.0.0.0/8"
      admin/profile: default
    settings:
      # Cap query working memory at 90% of the container memory limit, leaving ~10%
      # for the OS page cache (ClickHouse reads compressed parts through page cache).
      # CK reads its cgroup limit, so this ratio is relative to the container limit.
      max_server_memory_usage_to_ram_ratio: "0.9"
    clusters:
      - name: main
        layout:
          # 1 shard × 3 replicas, one per AZ. Each replica holds the full dataset;
          # reads spread across replicas and the cluster tolerates one replica loss.
          # Scale UP first (re-sharding has no auto-rebalance); add shards only when a single query
          # outgrows one node's CPU or the data outgrows one disk.
          shardsCount: __SHARDS__
          replicasCount: __REPLICAS__
  templates:
    serviceTemplates:
      - name: ch-cluster-ip
        spec:
          type: ClusterIP
          ports:
            - name: http
              port: 8123
            - name: native
              port: 9000
    podTemplates:
      - name: ch-pod
        spec:
          # backup sidecar assumes the S3 IAM role via IRSA through this SA
          # (created in 30-backup-cronjob.yaml — must be applied before this CHI).
          serviceAccountName: clickhouse-backup
          nodeSelector:
            workload: clickhouse
            ck-cluster: __CLUSTER__
          tolerations:
            - key: dedicated
              operator: Equal
              value: clickhouse
              effect: NoSchedule
          affinity:
            podAntiAffinity:
              requiredDuringSchedulingIgnoredDuringExecution:
                - labelSelector:
                    matchLabels:
                      clickhouse.altinity.com/app: chop
                      clickhouse.altinity.com/chi: __CLUSTER__
                  topologyKey: kubernetes.io/hostname
          topologySpreadConstraints:
            - maxSkew: 1
              topologyKey: topology.kubernetes.io/zone
              whenUnsatisfiable: DoNotSchedule
              labelSelector:
                matchLabels:
                  clickhouse.altinity.com/app: chop
                  clickhouse.altinity.com/chi: __CLUSTER__
          containers:
            - name: clickhouse
              image: "__CLICKHOUSE_IMAGE__"
              # Resource model for a DEDICATED node (one pod per i8g.4xlarge: 16 vCPU / 128 GiB).
              # - CPU: high request, NO limit. A CPU limit = CFS quota that throttles ClickHouse's
              #   parallel scan/merge threads at peak; on a dedicated node there is nothing to
              #   protect against, and modern CK is cgroup-aware (sizes its thread pool to the node).
              # - Memory: request == limit (Guaranteed QoS, avoids eviction). Set BELOW allocatable,
              #   not node capacity: kube-reserved + system-reserved + DaemonSets take a slice.
              #   Verify with `kubectl describe node` and adjust; page-cache headroom is handled by
              #   max_server_memory_usage_to_ram_ratio 0.9 above.
              resources:
                requests:
                  cpu: "__CPU_REQUEST__"
                  memory: "__MEMORY_REQUEST__"
                limits:
                  memory: "__MEMORY_REQUEST__"
            - name: clickhouse-backup
              image: "altinity/clickhouse-backup:2.6.0"
              args: ["server"]
              resources:
                requests:
                  cpu: "100m"
                  memory: "256Mi"
                limits:
                  cpu: "500m"
                  memory: "512Mi"
              env:
                - name: LOG_LEVEL
                  value: "info"
                - name: REMOTE_STORAGE
                  value: "s3"
                - name: S3_BUCKET
                  valueFrom:
                    configMapKeyRef:
                      name: clickhouse-backup-config
                      key: S3_BUCKET
                - name: S3_REGION
                  valueFrom:
                    configMapKeyRef:
                      name: clickhouse-backup-config
                      key: S3_REGION
                - name: S3_PATH
                  # Must match the cluster's own S3 prefix: the backup IAM role is
                  # scoped to s3://<bucket>/<cluster>/*, so any other path is denied.
                  value: "__CLUSTER__"
              ports:
                - name: backup-rest
                  containerPort: 7171
    volumeClaimTemplates:
      - name: ch-data
        spec:
          # Rendered by scripts/deploy.sh from the Terraform storage_profile:
          # ck-<cluster>-gp3 for the ebs profile (default), local-storage for local-nvme.
          # Do not apply this template directly.
          storageClassName: __STORAGE_CLASS__
          accessModes: [ReadWriteOnce]
          resources:
            requests:
              storage: __DATA_VOLUME_SIZE__Gi # sized to the i8g.4xlarge instance store (~3.75TB) so both profiles hold the same data; adjust per instance size
# No PodDisruptionBudget here on purpose, even though 1x3 could tolerate
# minAvailable: 2. The Altinity operator already creates one per cluster
# (chi-<chi>-<cluster>, maxUnavailable: 1), which gives the same guarantee of
# one replica down at a time. Adding a second PDB whose selector also matches
# these pods makes them permanently unevictable: the eviction API refuses any
# pod covered by more than one PDB, so `kubectl drain` fails with "This pod has
# more than one PodDisruptionBudget" and node rotation blocks indefinitely.
# Verified on the 1x2 comparison clusters during the 2026-08-13 P7b drill --
# drain failed with two PDBs present and completed in 7s once the hand-written
# one was removed.
