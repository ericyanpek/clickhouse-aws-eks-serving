apiVersion: v1
kind: ServiceAccount
metadata:
  name: clickhouse-backup
  namespace: __NAMESPACE__
  annotations:
    # Replace with this cluster's entry from `terraform output -json backup_role_arns` before apply
    eks.amazonaws.com/role-arn: "REPLACE_WITH_BACKUP_ROLE_ARN"
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: clickhouse-backup-config
  namespace: __NAMESPACE__
data:
  # Replace with `terraform output -raw backup_bucket` and your region before apply
  S3_BUCKET: "REPLACE_WITH_BUCKET"
  # One prefix per cluster: the backup IAM role only grants s3://<bucket>/<cluster>/*,
  # so clusters can neither overwrite nor read each other's backups.
  S3_PATH: "__CLUSTER__"
  S3_REGION: "us-east-1"
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: clickhouse-backup-daily
  namespace: __NAMESPACE__
spec:
  schedule: "0 2 * * *" # daily 02:00 UTC
  concurrencyPolicy: Forbid
  startingDeadlineSeconds: 3600
  successfulJobsHistoryLimit: 3
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      backoffLimit: 0
      template:
        spec:
          serviceAccountName: clickhouse-backup
          restartPolicy: OnFailure
          containers:
            - name: trigger
              image: curlimages/curl:8.10.1
              env:
                - name: POD_UID
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.uid
              command:
                - /bin/sh
                - -c
                - |
                  set -e
                  BACKUP_SET="backup-$(date -u +%Y%m%d-%H%M%S)-$POD_UID"
                  shard=0
                  while [ "$shard" -lt "__SHARDS__" ]; do
                    # Each shard owns different data. Use replica 0 of EVERY shard,
                    # and distinct names to avoid overwriting another shard in S3.
                    BACKUP="$BACKUP_SET-shard-$shard"
                    BASE="http://chi-__CLUSTER__-main-$shard-0.__NAMESPACE__.svc.cluster.local:7171"
                    echo "Creating $BACKUP"
                    curl --fail --silent --show-error --connect-timeout 10 \
                      -X POST "$BASE/backup/create?name=$BACKUP&background=false"
                    curl --fail --silent --show-error --connect-timeout 10 \
                      -X POST "$BASE/backup/upload/$BACKUP?background=false"
                    shard=$((shard + 1))
                  done
                  # A failed/partial run never emits this marker or succeeds as a Job.
                  # This is a set of per-shard backups, not an atomic cluster snapshot.
                  echo "BACKUP_SET_COMPLETE=$BACKUP_SET SHARDS=__SHARDS__"
