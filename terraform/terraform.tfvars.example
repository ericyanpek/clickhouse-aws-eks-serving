# Confirm instance availability and quotas in all three AZs before deploying.
region             = "us-east-1"
availability_zones = ["us-east-1a", "us-east-1b", "us-east-1c"]
cluster_name       = "clickhouse-eks"
cluster_version    = "1.34"

# Each cluster inherits availability_zones unless zones is explicitly provided.
# Additional shards require a sharding plan; history is not rebalanced.
clickhouse_clusters = {
  ebs = {
    storage_profile      = "ebs"
    shards               = 1
    replicas             = 3
    instance_type        = "r8g.4xlarge"
    data_volume_size_gib = 3400
    gp3_iops             = 20000
    gp3_throughput_mibps = 1250
    cpu_request          = "14"
    memory_request       = "110Gi"
    enable_backup        = true
  }
  # nvme = {
  #   storage_profile = "local-nvme"
  #   shards          = 1
  #   replicas        = 3
  #   instance_type   = "i8g.4xlarge"
  # }
}

operator_version  = "0.27.1"
enable_monitoring = true

# Set a globally unique name, or change cluster_name before using auto-naming.
backup_bucket_name = ""
# aws_profile = "my-profile"
# grafana_admin_password = "set-a-strong-password"

# Documentation-only CIDR. REPLACE with your actual office/VPN public CIDR.
public_access_cidrs = ["203.0.113.0/24"]
